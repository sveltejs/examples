		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.38.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.5.0",
		"vite": "^7.1.0"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.293.0",
		"@aws-sdk/s3-request-presigner": "^3.293.0"
